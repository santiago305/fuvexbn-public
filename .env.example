# decide si se registra con evidencias o sin evidencias
REGISTER_WITH_EVIDENCIA=true
# ventana diaria para registrar
FUVEXBN_REGISTER_WINDOW_START=08:00
FUVEXBN_REGISTER_WINDOW_END=19:00
FUVEXBN_REGISTER_WINDOW_BUFFER_MINUTES=120
# horas minimas desde la fecha/hora del filtro antes de registrar con evidencia
FUVEXBN_REGISTER_MIN_CONVERSATION_HOURS=3
# jitter aleatorio que se suma a la espera minima
FUVEXBN_REGISTER_CONVERSATION_JITTER_MINUTES_MIN=5
FUVEXBN_REGISTER_CONVERSATION_JITTER_MINUTES_MAX=75
# separacion minima entre slots de registro
FUVEXBN_REGISTER_SLOT_MIN_GAP_MINUTES=12
# desactiva el retry automatico de evidencias en el flujo final
FUVEXBN_EVIDENCE_AUTO_RETRY_ENABLED=false
# true: permite registrar usando FTELEFONO cuando TELEFONO esté vacío
# false: registra solo si hay TELEFONO
REGISTER_FTELEFONO=true
# true: permite crear evidencia usando FTELEFONO cuando TELEFONO esté vacío
# false: solo crea evidencia cuando TELEFONO tenga valor
EVIDENCE_FTELEFONO=true
# decide si filtra, registra o ambos
# 1 = solo filtrar
# 2 = solo registrar
# 3 = filtrar y registrar
FILTER_AND_REGISTER=3
FUVEXBN_FILTER_ACCEPTED_DAILY_LIMIT=25
FUVEXBN_REGISTERED_DAILY_LIMIT=20
EVIDENCIAS_DEFAULT_TASA=15.49
EVIDENCIAS_DEFAULT_PLAZO=60
# true: crea evidencia solo para filas con WHATSAPP=SI
# false: crea evidencia para todas las filas (WHATSAPP=SI y WHATSAPP=NO)
WHATSAPP_TELEFONO=true
# tipo 1 (whatsapp): habilita/deshabilita creación de evidencia
EVIDENCIA_WHTASAPP=true
# tipo 2 (sms): habilita/deshabilita creación de evidencia
EVIDENCIA_SMS=false
# tipo 3 (llamada): habilita/deshabilita creación de evidencia
EVIDENCIA_LLAMADA=false
# =========================
# login
# ========================
LOGIN_USERNAME=
LOGIN_PASSWORD=
USER_NAME=
USER=''
LOGIN_GOOGLE_EMAIL=yacilasandovalgeorgesantiago@gmail.com
