# =========================
# app
# =========================
APP_ENV=production

# =========================
# login / sentinel
# =========================
LOGIN_USER_SELECTOR=#USUARIO
LOGIN_PASS_SELECTOR=#password
LOGIN_SUBMIT_SELECTOR='form#login button[type="submit"]'
LOGIN_STEP_DELAY=2
LOGIN_URL=https://fuvexbn.a365.com.pe:7443/index.php
LOGIN_REDIRECT_TIMEOUT=1
LOGIN_SUCCESS_URL_CONTAINS=/general/menu.php
SENTINEL_URL=https://fuvexbn.a365.com.pe:7443/general/menu.php
SENTINEL_REFRESH_SECS=10
SENTINEL_CHECK_SELECTOR='a[href="cerrars.php"]'
SENTINEL_RELOGIN_ON_FAIL=true
MENU_URL=https://fuvexbn.a365.com.pe:7443/general/menu.php

# =========================
# urls / paths
# =========================
FUVEX_BASE=https://fuvexbn.a365.com.pe:7443
FILTER_BUSCAR_URL=https://fuvexbn.a365.com.pe:7443/BN/buscar_filtro.php
FILTER_INGRESAR_URL=https://fuvexbn.a365.com.pe:7443/BN/ingresar_filtro.php
REGISTRAR_CLIENTE_URL=https://fuvexbn.a365.com.pe:7443/BN/Registro_Prospecto_BN.php
PORTABILIDAD_URL=https://consulta.portabilidad.pe/?handler=Check
EVIDENCIAS=http://localhost:8000/
EVIDENCIAS_WHATSAPP_IMG_PATH=\\SAMSUNG-PC\xxxxxxxxxxx\fuvexbn\z_whatsapp
EXCELS_BASE_PATH=\\SAMSUNG-PC\xxxxxxxxxxx\fuvexbn

# =========================
# selectors
# =========================
X_DNI_INPUT=//*[@id="DNI_CLIENTE"]
X_TEL1_TIT_SELECT=#TEL1_TIT
X_TEL1_OPERADORA=#TEL1_OPERADORA

# =========================
# timings / batching
# =========================
TYPE_DELAY_MS=10
BETWEEN_DNI_MS=10
WAIT_VISIBLE_MS=5000
FEEDER_REFRESH_EVERY=30
FEEDER_REFRESH_SECONDS=30
FEEDER_REFRESH_JITTER_MS=1500
EXCEL_STATUS_BATCH_MAX=10
EXCEL_STATUS_BATCH_SECONDS=30

# =========================
# registration
# =========================
# decide si se registra con evidencias o sin evidencias
REGISTER_WITH_EVIDENCIA=true
# ventana diaria para registrar
FUVEXBN_REGISTER_WINDOW_START=08:00
FUVEXBN_REGISTER_WINDOW_END=19:00
FUVEXBN_REGISTER_WINDOW_BUFFER_MINUTES=120
# horas minimas desde la fecha/hora del filtro antes de registrar con evidencia
FUVEXBN_REGISTER_MIN_CONVERSATION_HOURS=3
# para filtros del mismo dia, espera minima antes de registrar
FUVEXBN_REGISTER_SAME_DAY_MIN_CONVERSATION_MINUTES=45
# para modo sin limite, espera maxima para filtros del mismo dia
FUVEXBN_REGISTER_SAME_DAY_MAX_CONVERSATION_MINUTES=180
# jitter aleatorio que se suma a la espera minima
FUVEXBN_REGISTER_CONVERSATION_JITTER_MINUTES_MIN=5
FUVEXBN_REGISTER_CONVERSATION_JITTER_MINUTES_MAX=75
# separacion minima entre slots de registro
FUVEXBN_REGISTER_SLOT_MIN_GAP_MINUTES=12
# desactiva el retry automatico de evidencias en el flujo final
FUVEXBN_EVIDENCE_AUTO_RETRY_ENABLED=false
# true: permite registrar usando FTELEFONO cuando TELEFONO esté vacío
# false: registra solo si hay TELEFONO
REGISTER_FTELEFONO=false
# true: permite crear evidencia usando FTELEFONO cuando TELEFONO esté vacío
# false: solo crea evidencia cuando TELEFONO tenga valor
EVIDENCE_FTELEFONO=false
# decide si filtra, registra o ambos
# 1 = solo filtrar
# 2 = solo registrar
# 3 = filtrar y registrar
# 4 = solo evidencias (piloto: Ingresar/Registrar apagados)
# 5 = regeneracion (solo revidencias desde recuperacion/regenerar)
FILTER_AND_REGISTER=5
# limite de filtros aceptados = 0 ilimitados
FUVEXBN_FILTER_ACCEPTED_DAILY_LIMIT=0
# limite de registros = 0 ilimitados
FUVEXBN_REGISTERED_DAILY_LIMIT=0

# =========================
# evidencias
# =========================
EVIDENCIAS_DEFAULT_TASA=15.49
EVIDENCIAS_DEFAULT_PLAZO=60
# tabla editable TASA -> TCEA; vacío usa fuvexbn/config/tcea_rates.json
TCEA_RATES_PATH=
# true: crea evidencia solo para filas con WHATSAPP=SI
# false: crea evidencia para todas las filas (WHATSAPP=SI y WHATSAPP=NO)
WHATSAPP_TELEFONO=false
# tipo 1 (whatsapp): habilita/deshabilita creación de evidencia
EVIDENCIA_WHTASAPP=true
# tipo 2 (sms): habilita/deshabilita creación de evidencia
EVIDENCIA_SMS=false
# tipo 3 (llamada): habilita/deshabilita creación de evidencia
EVIDENCIA_LLAMADA=false
